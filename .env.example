# Copy this file to .env and fill in your values
# Never commit the actual .env file to Git

# A long random string used to sign JWT tokens
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# MongoDB connection string
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
DB_NAME=enterprise_copilot_db

# Ollama base URL
# Local dev: http://localhost:11434
# Docker:    http://ollama:11434  (set automatically by docker-compose)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LLM Provider: "groq" (cloud, fast) or "ollama" (local)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
