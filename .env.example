# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git!

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string
# For Local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: paste your cluster connection string here in your private .env file
MONGO_URI=mongodb://localhost:27017
DB_NAME=enterprise_copilot_db

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Use "groq" for the cloud deployment (fast, free tier available)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
# Available Groq models: openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# ─── Frontend (Vercel / Docker) ────────────────────────────────────────────────
# Set this to your Render backend URL when deploying to Vercel/Docker
# FRONTEND_URL=https://your-frontend.vercel.app
